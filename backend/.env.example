# NER-LOGIX FastAPI Backend Configuration Template
# SIH 2026 / SIH26002 - MDoNER Logistics Intelligence

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Future PostgreSQL / PostGIS Spatial Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Note: A live database is OPTIONAL for foundation and presentation modes.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
